# OAuth 2.0 application settings from the X Developer Console.
XDIGEST_X_CLIENT_ID=
XDIGEST_X_CLIENT_SECRET=
XDIGEST_X_REDIRECT_URI=http://localhost:8080/callback
XDIGEST_X_SCOPE=bookmark.read tweet.read users.read offline.access

# Comma-separated bookmark folder names or IDs to skip during sync.
XDIGEST_IGNORE_FOLDERS=

# Structured log level: debug, info, warning, error.
# XDIGEST_LOG_LEVEL=info
# Aggregate log rotation: maximum bytes per file and number of backups.
# XDIGEST_LOG_MAX_BYTES=5000000
# XDIGEST_LOG_BACKUPS=5

# Weekly backup to Google Cloud Storage (rclone gcs remote).
# Set the bucket name and rclone remote. The bucket must be a private GCS
# bucket in an Always Free region (us-central1, us-west1, us-east1).
XDIGEST_BACKUP_BUCKET=
XDIGEST_BACKUP_REMOTE=gcs
# The rclone gcs remote uses a service account JSON key, for example:
# $HOME/.config/gcloud/x-digest-backup-key.json
# Configure it with: rclone config create gcs googlecloudstorage service_account_file <path> bucket_policy_only true

# OAuth 2.0 application settings from the X Developer Console.
XDIGEST_X_CLIENT_ID=
XDIGEST_X_CLIENT_SECRET=
XDIGEST_X_REDIRECT_URI=http://localhost:8080/callback
XDIGEST_X_SCOPE=bookmark.read tweet.read users.read offline.access

# Comma-separated bookmark folder names or IDs to skip during sync.
XDIGEST_IGNORE_FOLDERS=

# Comma-separated X usernames (with or without @) or author IDs to skip.
# Matching posts are not archived, indexed, or digested. Stays in local .env.
XDIGEST_IGNORE_ACCOUNTS=

# Structured log level: debug, info, warning, error.
# XDIGEST_LOG_LEVEL=info
# Aggregate log rotation: maximum bytes per file and number of backups.
# XDIGEST_LOG_MAX_BYTES=5000000
# XDIGEST_LOG_BACKUPS=5

# Weekly Telegram content digest via OpenRouter.
# Either prefixed name works for the bot token and chat ID. The legacy
# TELEGRAM_BOT_TOKEN and TELEGRAM_USER_ID names are accepted as aliases.
# XDIGEST_TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=
# XDIGEST_TELEGRAM_CHAT_ID=
# TELEGRAM_USER_ID=
# XDIGEST_LLM_API_KEY=  # Prefer the macOS Keychain for this value:
# service `x-digest`, account `openrouter-api-key`. A set
# XDIGEST_LLM_API_KEY value takes precedence over the Keychain entry.
# XDIGEST_LLM_MODEL=z-ai/glm-5.3-flash
# XDIGEST_LLM_REASONING_EFFORT=low
# XDIGEST_LLM_BASE_URL=https://openrouter.ai/api/v1
# Optional digest tuning: maximum posts per delivery and prompt budget.
# XDIGEST_DIGEST_MAX_POSTS=20
# XDIGEST_DIGEST_MAX_CHARS_PER_POST=800
# Keychain fallback uses service `x-digest` with accounts
# `telegram-bot-token`, `telegram-chat-id`, and `openrouter-api-key`.
# Routing to the cheapest Zero Data Retention provider is handled in code.

# Weekly backup to Google Cloud Storage (rclone gcs remote).
# Set the bucket name and rclone remote. The bucket must be a private GCS
# bucket in an Always Free region (us-central1, us-west1, us-east1).
XDIGEST_BACKUP_BUCKET=
XDIGEST_BACKUP_REMOTE=gcs
# The rclone gcs remote uses a service account JSON key, for example:
# $HOME/.config/gcloud/x-digest-backup-key.json
# Configure it with: rclone config create gcs googlecloudstorage service_account_file <path> bucket_policy_only true

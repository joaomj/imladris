#!/bin/sh
# Daily problem report for launchd. The file name is what macOS shows under
# Login Items, so the job runs through it instead of calling uv directly.
# A run stops after 10 minutes.
cd "$(dirname "$0")/.." || exit 1
exec /usr/bin/timeout -k 1m 10m "${UV_BIN:-uv}" run --project . x-digest health --notify
